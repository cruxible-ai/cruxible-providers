{
  "schema_version": 2,
  "manifest": {
    "path": "manifest.yaml",
    "digest": "sha256:73e089a689bb602d2df61d2c1179a4f037bdb8a03c988eedbc70c79b98d235b7"
  },
  "operations": [
    {
      "name": "search.web",
      "in": "search.web.request@1",
      "out": "search.web.result@1",
      "effect": "external_read",
      "refusals": {
        "cross_origin_credentialed_redirect": {
          "contract": "search.web.refusal.cross_origin_credentialed_redirect@1",
          "absorbable": false
        },
        "provider_declined": {
          "contract": "search.web.refusal.provider_declined@1",
          "absorbable": true
        },
        "redirect_limit": {
          "contract": "search.web.refusal.redirect_limit@1",
          "absorbable": false
        },
        "unsupported_redirect_scheme": {
          "contract": "search.web.refusal.unsupported_redirect_scheme@1",
          "absorbable": false
        }
      },
      "entrypoint": "cruxible_provider_web.search:SearxngSearch"
    },
    {
      "name": "web.fetch",
      "in": "web.fetch.request@1",
      "out": "web.fetch.result@1",
      "effect": "external_read",
      "refusals": {
        "cross_origin_credentialed_redirect": {
          "contract": "web.fetch.refusal.cross_origin_credentialed_redirect@1",
          "absorbable": false
        },
        "provider_declined": {
          "contract": "web.fetch.refusal.provider_declined@1",
          "absorbable": true
        },
        "redirect_limit": {
          "contract": "web.fetch.refusal.redirect_limit@1",
          "absorbable": false
        },
        "unsupported_redirect_scheme": {
          "contract": "web.fetch.refusal.unsupported_redirect_scheme@1",
          "absorbable": false
        }
      },
      "entrypoint": "cruxible_provider_web.fetch:WebFetch"
    }
  ],
  "runtime_requirements": [
    {
      "entrypoint": "cruxible_provider_web.fetch:WebFetch",
      "kind": "python_extra",
      "name": "browser",
      "description": "Required Python extra for this implementation."
    },
    {
      "entrypoint": "cruxible_provider_web.fetch:WebFetch",
      "kind": "runtime_resource",
      "name": "playwright.chromium",
      "description": "Rendered fetches require a Chromium browser matching the installed Playwright version; installing the Python extra alone is insufficient.",
      "probe_entrypoint": "cruxible_provider_web.resources:chromium_available"
    }
  ]
}
