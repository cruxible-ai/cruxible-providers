{
  "artifact_format": "cruxible-contract-v1",
  "description": "One query to the configured search instance. The instance is run configuration, not a request field; time_range is the instance's own recency filter.",
  "fields": {
    "language": {
      "optional": true,
      "type": {
        "kind": "string",
        "min_len": 1
      }
    },
    "query": {
      "type": {
        "kind": "string",
        "pattern": "^\\s*\\S[\\s\\S]*$"
      }
    },
    "time_range": {
      "optional": true,
      "type": {
        "kind": "enum",
        "members": [
          "day",
          "month",
          "year"
        ]
      }
    }
  },
  "name": "search.web.request",
  "version": 1
}
