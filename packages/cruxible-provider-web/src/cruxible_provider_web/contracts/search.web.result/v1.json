{
  "artifact_format": "cruxible-contract-v1",
  "description": "One search answer as Capture wire: the exact response body the instance sent, its HTTP coordinate and the observation time.",
  "fields": {
    "byte_length": {
      "type": {
        "kind": "int",
        "min": 0
      }
    },
    "bytes_digest": {
      "type": {
        "kind": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "content_base64": {
      "type": {
        "kind": "string"
      }
    },
    "content_encoding": {
      "type": {
        "kind": "enum",
        "members": [
          "base64"
        ]
      }
    },
    "coordinate": {
      "type": {
        "contract": {
          "digest": "sha256:323753c310e7af28b18a5dcc1f6bb434a88c286affa7c84bd1c04477f664bd5d",
          "name": "web.capture.coordinate",
          "version": 1
        },
        "kind": "contract"
      }
    },
    "coordinate_type": {
      "type": {
        "kind": "enum",
        "members": [
          "http-response-v1"
        ]
      }
    },
    "observed_at": {
      "type": {
        "kind": "datetime"
      }
    },
    "replayability": {
      "type": {
        "kind": "enum",
        "members": [
          "attested_only"
        ]
      }
    },
    "selector": {
      "type": {
        "contract": {
          "digest": "sha256:3333934af2eaa8df454a1b8720481a073de5633eac6e7b923db224f5570682fe",
          "name": "web.capture.selector",
          "version": 1
        },
        "kind": "contract"
      }
    },
    "selector_type": {
      "type": {
        "kind": "enum",
        "members": [
          "whole-response-v1"
        ]
      }
    },
    "source_effective_time": {
      "optional": true,
      "type": {
        "contract": {
          "digest": "sha256:4f77f75bc2bbec9b949e3d9e5f86aa28d6a51df8a51dfd8fdddd183422ad27c0",
          "name": "web.capture.source_effective_time",
          "version": 1
        },
        "kind": "contract"
      }
    },
    "source_identity": {
      "type": {
        "kind": "enum",
        "members": [
          "search.response"
        ]
      }
    },
    "tag": {
      "type": {
        "kind": "enum",
        "members": [
          "playbill-provider-result-to-external-capture-v1"
        ]
      }
    }
  },
  "name": "search.web.result",
  "version": 1
}
