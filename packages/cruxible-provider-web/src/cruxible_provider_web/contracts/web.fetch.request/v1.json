{
  "artifact_format": "cruxible-contract-v1",
  "description": "One resource to retrieve. A credential is named by reference; its material stays in the run's secret custody, never in this payload.",
  "fields": {
    "credential_header": {
      "optional": true,
      "type": {
        "kind": "string",
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
      }
    },
    "credential_ref": {
      "optional": true,
      "type": {
        "kind": "string"
      }
    },
    "expected_format": {
      "optional": true,
      "type": {
        "kind": "enum",
        "members": [
          "auto",
          "bytes",
          "csv",
          "html",
          "json",
          "text"
        ]
      }
    },
    "extract": {
      "optional": true,
      "type": {
        "kind": "bool"
      }
    },
    "logical_source": {
      "optional": true,
      "type": {
        "kind": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,255}$"
      }
    },
    "max_bytes": {
      "optional": true,
      "type": {
        "kind": "int",
        "max": 33554432,
        "min": 1
      }
    },
    "paced": {
      "optional": true,
      "type": {
        "kind": "bool"
      }
    },
    "render": {
      "optional": true,
      "type": {
        "kind": "bool"
      }
    },
    "url": {
      "type": {
        "kind": "string",
        "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://\\S+$"
      }
    }
  },
  "name": "web.fetch.request",
  "version": 1
}
